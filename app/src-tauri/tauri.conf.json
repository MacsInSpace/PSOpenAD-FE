{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PSOpenAD",
  "version": "1.0.0",
  "identifier": "app.psopenad.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:14320",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PSOpenAD - Users and Computers",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../sidecar": "sidecar",
      "../../vendor": "vendor"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
